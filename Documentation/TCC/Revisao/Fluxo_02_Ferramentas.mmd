flowchart TD
    A["Backend busca documentos no ChromaDB<br/>Prepara operação + contexto + ferramentas"]:::data
    B["LLM escolhe as chamadas<br/>Backend fixa usuário e dados financeiros"]:::ai
    P["fee_policy<br/>Cliente do backend chama o servidor MCP"]:::mcp
    Q["MCP devolve política de custos<br/>e ressalvas sobre estimativas"]:::mcp
    D{"Preço de aquisição já informado?"}:::decision
